{
  "name": "revise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest --config vitest.integration.config.ts --run",
    "test:integration:db": "vitest run --config vitest.integration.config.ts src/app/actions/__tests__/ai-usage-tracking.integration.test.ts src/application/services/__tests__/AIContextBuilder.integration.test.ts src/infrastructure/document/document-pipeline.integration.test.ts src/infrastructure/persistence/MongoDBExchangeRepository.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm test && npm run build",
    "migrate:writing-goals": "node scripts/migrate-writing-goals.mjs",
    "backfill:word-count": "node scripts/backfill-word-count-snapshots.mjs",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f mongodb"
  },
